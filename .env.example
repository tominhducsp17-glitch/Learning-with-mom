APP_ENV=local

# Fill this locally to enable OCR LaTeX suggestions.
AUTO_OCR_ON_IMPORT=true
AUTO_OCR_MAX_WORKERS=6
AUTO_OCR_BATCH_SIZE=20
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
# Optional fallback keys, comma-separated. The app tries GEMINI_API_KEY first, then these.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite

# Local runtime paths.
MATH_EXAM_STORAGE_ROOT=storage
MATH_EXAM_DATABASE_PATH=storage/math_exam.sqlite3
MAX_UPLOAD_MB=25

# Optional WMF/EMF converter. Leave as "magick" when ImageMagick is on PATH.
MAGICK_BINARY=magick
