APP_ENV=production

# Keep this path inside the Docker volume mounted at /app/storage.
MATH_EXAM_STORAGE_ROOT=/app/storage
MATH_EXAM_DATABASE_PATH=/app/storage/math_exam.sqlite3
MAX_UPLOAD_MB=25
PUBLIC_BASE_URL=

# Debian ImageMagick 6 exposes the converter as "convert".
MAGICK_BINARY=convert
MATH_EXAM_CUSTOM_FONT_DIR=/usr/local/share/fonts/mathexam

# Fill this in the deployment environment to enable OCR LaTeX suggestions.
AUTO_OCR_ON_IMPORT=true
AUTO_OCR_MAX_WORKERS=6
AUTO_OCR_BATCH_SIZE=20
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
# Optional fallback keys, comma-separated. The app tries GEMINI_API_KEY first, then these.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
