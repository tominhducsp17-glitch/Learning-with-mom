APP_ENV=production

# Keep this path inside the Docker volume mounted at /app/storage.
MATH_EXAM_STORAGE_ROOT=/app/storage
MATH_EXAM_DATABASE_PATH=/app/storage/math_exam.sqlite3
MAX_UPLOAD_MB=25
PUBLIC_BASE_URL=

# Single teacher account. Set ADMIN_PASSWORD in Railway/Docker environment variables.
ADMIN_USERNAME=0912311121
ADMIN_PASSWORD=
ADMIN_SESSION_DAYS=7

# Debian ImageMagick 6 exposes the converter as "convert".
MAGICK_BINARY=convert
MATH_EXAM_CUSTOM_FONT_DIR=/usr/local/share/fonts/mathexam

# Fill this in the deployment environment to enable OCR LaTeX suggestions.
AUTO_OCR_ON_IMPORT=true
AUTO_OCR_MAX_WORKERS=6
AUTO_OCR_BATCH_SIZE=20
AI_PROVIDER=gemini
AI_PROVIDER_CHAIN=gemini,openrouter,nvidia
CHAT_PROVIDER_CHAIN=tokenrouter,gemini,openrouter,nvidia
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
# Optional fallback keys, comma-separated. The app tries GEMINI_API_KEY first, then these.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
# Chatbot tries these Gemini models in order with the same key chain.
GEMINI_CHAT_MODEL_CHAIN=gemini-3.1-flash-lite,gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_CHAT_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash
NVIDIA_API_KEY=
NVIDIA_OCR_MODEL=nvidia/nemotron-ocr-v2
# Direct NVIDIA OCR needs a hosted/self-hosted NIM OCR base URL. Leave empty to skip NVIDIA for OCR.
NVIDIA_OCR_BASE_URL=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
